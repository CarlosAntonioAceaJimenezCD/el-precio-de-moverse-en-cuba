# Entornos y cachés / Environments and caches
.venv/
**/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
Auxiliares/cache/
*.log

# Repositorios auxiliares: NO se suben, solo se listan como referencia en README.md
# Auxiliary repositories: not uploaded, only listed as references in README.md
Auxiliares/Repositorios/
Auxiliares/Repositorios Referencias/
Hombros/03_Repositorios/
Copias/

# Corpus legal completo: no versionar (usar almacenamiento externo o Git LFS)
# Full legal corpus: not versioned (use external storage or Git LFS)
Anexos/Leyes/*
!Anexos/Leyes/gaceta_catalog.json
!Anexos/Leyes/.herramientas/
Anexos/Leyes/.herramientas/__pycache__/

# Bases grandes: gestionadas con Git LFS (ver .gitattributes)
# Large databases: managed with Git LFS (see .gitattributes)
Data/Revolico/.revolico_sync.lock
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Bases de trabajo locales: se distribuyen en chunks, no se versiona el original
# Local working databases: distributed as chunks, originals are not versioned
Data/Revolico/revolico.sqlite
Data/Revolico/pipeline.sqlite
Data/Revolico/partes/
Data/mapas/circuitos_estado.sqlite

# Estado interno del script de informe / Internal report script state
Auxiliares/herramientas/.informe_state.json

# Salidas locales / Local outputs
Data/raw/
Data/processed/
outputs/
.DS_Store
Thumbs.db

# Sitio generado
site/

# Reporte operativo de la subida (lo reescribe el timer cada 10 min)
Data/PROGRESO_PUSH.md

# Huella del panel: estado operativo generado, no contenido
Data/_state/dashboard_fingerprint.json
